{
  "$schema": "https://developer.microsoft.com/json-schemas/spfx-build/config.2.0.schema.json",
  "version": "2.0",
  "bundles": {
    "nrs-home-page-web-part": {
      "components": [
        {
          "entrypoint": "./lib/webparts/nrsHomePage/NrsHomePageWebPart.js",
          "manifest": "./src/webparts/nrsHomePage/NrsHomePageWebPart.manifest.json"
        }
      ]
    },
    "nrs-footer-web-part": {
      "components": [
        {
          "entrypoint": "./lib/webparts/nrsFooter/NrsFooterWebPart.js",
          "manifest": "./src/webparts/nrsFooter/NrsFooterWebPart.manifest.json"
        }
      ]
    },
    "nrs-hr-domains-web-part": {
      "components": [
        {
          "entrypoint": "./lib/webparts/nrsHrDomains/NrsHrDomainsWebPart.js",
          "manifest": "./src/webparts/nrsHrDomains/NrsHrDomainsWebPart.manifest.json"
        }
      ]
    },
    "nrs-hr-policies-a-to-z-web-part": {
      "components": [
        {
          "entrypoint": "./lib/webparts/nrsHrPoliciesAToZ/NrsHrPoliciesAToZWebPart.js",
          "manifest": "./src/webparts/nrsHrPoliciesAToZ/NrsHrPoliciesAToZWebPart.manifest.json"
        }
      ]
    },
    "forms-and-resources-web-part": {
      "components": [
        {
          "entrypoint": "./lib/webparts/formsAndResources/FormsAndResourcesWebPart.js",
          "manifest": "./src/webparts/formsAndResources/FormsAndResourcesWebPart.manifest.json"
        }
      ]
    },
    "fa-qs-and-knowledge-web-part": {
      "components": [
        {
          "entrypoint": "./lib/webparts/faQsAndKnowledge/FaQsAndKnowledgeWebPart.js",
          "manifest": "./src/webparts/faQsAndKnowledge/FaQsAndKnowledgeWebPart.manifest.json"
        }
      ]
    },
    "ask-hr-web-part": {
      "components": [
        {
          "entrypoint": "./lib/webparts/askHr/AskHrWebPart.js",
          "manifest": "./src/webparts/askHr/AskHrWebPart.manifest.json"
        }
      ]
    },
    "nrs-hr-domain-subpage-web-part": {
      "components": [
        {
          "entrypoint": "./lib/webparts/nrsHrDomainSubpage/NrsHrDomainSubpageWebPart.js",
          "manifest": "./src/webparts/nrsHrDomainSubpage/NrsHrDomainSubpageWebPart.manifest.json"
        }
      ]
    }
  },
  "externals": {},
  "localizedResources": {
    "NrsHomePageWebPartStrings": "lib/webparts/nrsHomePage/loc/{locale}.js",
    "NrsFooterWebPartStrings": "lib/webparts/nrsFooter/loc/{locale}.js",
    "NrsHrDomainsWebPartStrings": "lib/webparts/nrsHrDomains/loc/{locale}.js",
    "NrsHrPoliciesAToZWebPartStrings": "lib/webparts/nrsHrPoliciesAToZ/loc/{locale}.js",
    "FormsAndResourcesWebPartStrings": "lib/webparts/formsAndResources/loc/{locale}.js",
    "FaQsAndKnowledgeWebPartStrings": "lib/webparts/faQsAndKnowledge/loc/{locale}.js",
    "AskHrWebPartStrings": "lib/webparts/askHr/loc/{locale}.js",
    "NrsHrDomainSubpageWebPartStrings": "lib/webparts/nrsHrDomainSubpage/loc/{locale}.js"
  }
}
